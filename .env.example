# SampMail Production Environment Configuration
# Copy this file to .env and customize for your deployment

# ===========================================
# REQUIRED SETTINGS
# ===========================================

# Application secret (min 32 chars) - Generate with: openssl rand -base64 32
SAMPMAIL_SECRET=your-super-secret-key-minimum-32-characters-long

# PostgreSQL credentials
POSTGRES_USER=sampmail
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_DB=sampmail

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Database driver: sqlite (dev) or postgres (production)
SAMPMAIL_DB_DRIVER=postgres

# PostgreSQL settings (when using postgres driver)
SAMPMAIL_PG_HOST=postgres
SAMPMAIL_PG_PORT=5432
SAMPMAIL_PG_SSLMODE=disable
SAMPMAIL_DB_MAX_OPEN_CONNS=100
SAMPMAIL_DB_MAX_IDLE_CONNS=10

# ===========================================
# REDIS CONFIGURATION (Optional but recommended)
# ===========================================

# Redis for distributed rate limiting
SAMPMAIL_REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Listen address
SAMPMAIL_LISTEN_ADDR=0.0.0.0:9000

# Environment
SAMPMAIL_ENV=production

# Request settings
SAMPMAIL_REQUEST_TIMEOUT=30s
SAMPMAIL_MAX_REQUEST_BODY=10485760
SAMPMAIL_SHUTDOWN_TIMEOUT=30s

# ===========================================
# TLS CONFIGURATION (Optional - use nginx instead)
# ===========================================

# Enable TLS directly (not recommended - use nginx)
SAMPMAIL_TLS_ENABLED=false
# SAMPMAIL_TLS_CERT=/path/to/cert.pem
# SAMPMAIL_TLS_KEY=/path/to/key.pem

# ===========================================
# PROXY CONFIGURATION
# ===========================================

# Trust proxy headers (enable when behind nginx/load balancer)
SAMPMAIL_TRUST_PROXY=true
SAMPMAIL_TRUSTED_PROXY_CIDR=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ===========================================
# SMTP CONFIGURATION
# ===========================================

# KumoMTA address
SAMPMAIL_SMTP_ADDR=127.0.0.1:587
SAMPMAIL_SMTP_MAX_CONNS=100
SAMPMAIL_SMTP_MIN_CONNS=5
SAMPMAIL_SMTP_CONN_TIMEOUT=10s

# KumoMTA paths
SAMPMAIL_KUMO_DIR=/opt/kumomta
SAMPMAIL_LOG_DIR=/var/log/kumomta
SAMPMAIL_SPOOL_DIR=/var/spool/kumomta

# ===========================================
# EMAIL VERIFICATION (Reacher)
# ===========================================

REACHER_URL=http://reacher:8080
# REACHER_API_KEY=  # For Reacher Cloud

# ===========================================
# CAMPAIGN SETTINGS
# ===========================================

SAMPMAIL_CAMPAIGN_WORKERS=50
SAMPMAIL_IMPORT_BATCH_SIZE=500

# ===========================================
# SECURITY SETTINGS
# ===========================================

# Bcrypt cost (12-14 recommended for production)
SAMPMAIL_BCRYPT_COST=12

# Firewall (auto-block malicious IPs)
SAMPMAIL_FIREWALL_ENABLED=true

# ===========================================
# BACKUP SETTINGS
# ===========================================

# Number of config backups to retain
SAMPMAIL_BACKUP_RETENTION=7

# Data directory
SAMPMAIL_DATA_DIR=/var/lib/sampmail

# ===========================================
# MONITORING & LOGGING
# ===========================================

# Prometheus metrics
SAMPMAIL_METRICS_ENABLED=true
SAMPMAIL_METRICS_PATH=/metrics

# Logging
SAMPMAIL_LOG_LEVEL=info
SAMPMAIL_LOG_JSON=true

# ===========================================
# VERSION INFO (Set during build)
# ===========================================

SAMPMAIL_VERSION=0.1.12
# BUILD_TIME=
# GIT_COMMIT=
